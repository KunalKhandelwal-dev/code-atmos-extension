{
  "manifest_version": 3,
  "name": "CodeAtmos — LeetCode Theme Lab",
  "version": "0.1.0",
  "description": "Clean, distraction-free laboratory themes for LeetCode problem solving.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeAtmos — LeetCode Theme Lab"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "css": [
        "themes.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
